# Optional OpenAI-compatible generation. Without a key, answers use retrieved
# source excerpts and are clearly labeled evidence-only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional semantic embeddings. Set to "openai" to embed indexed chunks and
# queries using the configured API. The default "local" uses local hybrid search.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# App behavior
DATA_DIR=data
MAX_UPLOAD_MB=10
RETRIEVAL_MIN_SCORE=0.12
