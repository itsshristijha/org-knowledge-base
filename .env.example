# Auth.js v5 Google OAuth credentials and session signing secret.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Neon Postgres connection string (use the pooled connection string).
DATABASE_URL=

# Optional OpenAI-compatible answer generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
